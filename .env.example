VAULT_PATH=/path/to/your/obsidian/vault
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OLLAMA_URL=http://localhost:11434
LANCE_DB_PATH=./data/vault.lance
MCP_PORT=3789
MCP_TRANSPORT=http      # http (streamable, default) | stdio
VAULT_API_KEY=          # set to enable Bearer token auth (required for public exposure)

# Optional SECOND credential: a secret first path segment (e.g. /v-<32 hex>)
# that authenticates by itself, for clients that cannot send headers at all —
# specifically Claude custom connectors, where Anthropic's servers make the
# connection rather than your device. Blank = disabled (bearer-only).
#
# ⚠️ This trades header secrecy for URL secrecy over a PRIVATE vault. Anyone
# holding the URL can read every note and trigger vault_reindex; rotating this
# value is the only revocation. Do not enable it casually.
VAULT_FUNNEL_PREFIX=
